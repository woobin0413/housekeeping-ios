# Copy to .env.cloud (ignored), fill locally, and never paste the values into chat or source.
SUPABASE_ACCESS_TOKEN=
HK_SUPABASE_PROJECT_REF=
HK_SUPABASE_EXPECTED_REGION=us-east-1
HK_SUPABASE_EXPECTED_NAME="HouseKeeping Private"
HK_CLOUD_AUDIT_PHASE=pre-deploy
# custom-smtp is required for dependable delivery. supabase-team-only is limited to authorized team addresses.
HK_EMAIL_DELIVERY_MODE=custom-smtp
